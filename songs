padding:18px;

border-radius:18px;

margin-bottom:18px;

box-shadow:0 8px 20px rgba(0,0,0,.12);

display:flex;

align-items:center;

gap:15px;

transition:.35s;

}

.song:hover{

transform:translateY(-4px);

}

.icon{

font-size:28px;

}

.name{

font-size:20px;

color:#444;

}

.footer{

text-align:center;

margin-top:35px;

font-size:20px;

color:#6a1b9a;

}

</style>

</head>

<body>

